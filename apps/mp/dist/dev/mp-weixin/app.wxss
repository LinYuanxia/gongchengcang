.text-primary {
  color: #165dff;
}
.text-success {
  color: #00b42a;
}
.text-warning {
  color: #ff7d00;
}
.text-danger {
  color: #f53f3f;
}
.text-secondary {
  color: #86909c;
}
.bg-white {
  background-color: #fff;
}
.flex {
  display: flex;
}
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-column {
  display: flex;
  flex-direction: column;
}
.flex-1 {
  flex: 1;
}
.ml-8 {
  margin-left: 16rpx;
}
.mr-8 {
  margin-right: 16rpx;
}
.mb-16 {
  margin-bottom: 32rpx;
}
.mt-16 {
  margin-top: 32rpx;
}
.p-16 {
  padding: 32rpx;
}
.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.btn-primary {
  background-color: #165dff;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}
.btn-primary::after {
  border: none;
}
.btn-default {
  background-color: #fff;
  color: #1d2129;
  border: 1rpx solid #e5e6eb;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}
.btn-default::after {
  border: none;
}
page {
  background-color: #f7f8fa;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
