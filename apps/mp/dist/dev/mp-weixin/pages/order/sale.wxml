<view class="page data-v-171234fc"><view class="tabs data-v-171234fc"><view class="{{['tab-item', 'data-v-171234fc', b && 'active']}}" bindtap="{{c}}"><text class="tab-text data-v-171234fc">全部</text><text class="tab-count data-v-171234fc">{{a}}</text></view><view class="{{['tab-item', 'data-v-171234fc', e && 'active']}}" bindtap="{{f}}"><text class="tab-text data-v-171234fc">待发货</text><text class="tab-count data-v-171234fc">{{d}}</text></view><view class="{{['tab-item', 'data-v-171234fc', h && 'active']}}" bindtap="{{i}}"><text class="tab-text data-v-171234fc">已发货</text><text class="tab-count data-v-171234fc">{{g}}</text></view><view class="{{['tab-item', 'data-v-171234fc', k && 'active']}}" bindtap="{{l}}"><text class="tab-text data-v-171234fc">已完成</text><text class="tab-count data-v-171234fc">{{j}}</text></view><view class="{{['tab-item', 'data-v-171234fc', n && 'active']}}" bindtap="{{o}}"><text class="tab-text data-v-171234fc">售后</text><text class="tab-count data-v-171234fc">{{m}}</text></view></view><view class="search-bar data-v-171234fc"><view class="search-input data-v-171234fc"><text class="search-icon data-v-171234fc">🔍</text><input class="data-v-171234fc" type="text" placeholder="搜索订单号/商品名称" placeholder-class="placeholder" value="{{p}}" bindinput="{{q}}"/></view></view><view class="order-list data-v-171234fc"><view wx:for="{{r}}" wx:for-item="order" wx:key="k" class="order-card data-v-171234fc" bindtap="{{order.l}}"><view class="order-header data-v-171234fc"><view class="order-no data-v-171234fc"><text class="label data-v-171234fc">订单号：</text><text class="value data-v-171234fc">{{order.a}}</text></view><view class="{{['order-status', 'data-v-171234fc', order.c]}}"><text class="data-v-171234fc">{{order.b}}</text></view></view><view class="order-products data-v-171234fc"><view wx:for="{{order.d}}" wx:for-item="item" wx:key="f" class="product-item data-v-171234fc"><image src="{{item.a}}" class="product-image data-v-171234fc" mode="aspectFill"/><view class="product-info data-v-171234fc"><text class="product-name data-v-171234fc">{{item.b}}</text><text class="product-spec data-v-171234fc">{{item.c}}</text><view class="product-price-row data-v-171234fc"><text class="product-price data-v-171234fc">¥{{item.d}}</text><text class="product-qty data-v-171234fc">x{{item.e}}</text></view></view></view></view><view class="order-footer data-v-171234fc"><view class="order-amount data-v-171234fc"><text class="amount-label data-v-171234fc">订单金额：</text><text class="amount-value data-v-171234fc">¥{{order.e}}</text></view><view class="order-actions data-v-171234fc"><view wx:if="{{order.f}}" class="action-btn primary data-v-171234fc" catchtap="{{order.g}}"><text class="data-v-171234fc">发货</text></view><view wx:if="{{order.h}}" class="action-btn data-v-171234fc" catchtap="{{order.i}}"><text class="data-v-171234fc">物流</text></view><view class="action-btn data-v-171234fc" catchtap="{{order.j}}"><text class="data-v-171234fc">详情</text></view></view></view></view><view wx:if="{{s}}" class="empty data-v-171234fc"><text class="empty-icon data-v-171234fc">📋</text><text class="empty-text data-v-171234fc">暂无订单数据</text></view></view></view>